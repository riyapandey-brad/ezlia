<style>
  .sbc-row-{{ section.id }} {
    margin: 0 50px 0 50px;
  }

  .sbc-row-{{ section.id }} .sbc-row__header {
    text-align: left;
    margin-bottom: 16px;
  }

  .sbc-row-{{ section.id }} .sbc-row__title {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sbc-row-{{ section.id }} .sbc-row__subtitle {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    margin-top: 4px;
  }

  .sbc-row-{{ section.id }} .sbc-row__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .sbc-row-{{ section.id }} .sbc-row__card {
    position: relative;
    display: block;
    height: 205px;
    text-decoration: none;
    background: #f5f5f5;
    overflow: hidden;
  }

  .sbc-row-{{ section.id }} .sbc-row__image {
    width: 100%;
    height: 170px;
    object-fit: cover;
    display: block;
  }

  .sbc-row-{{ section.id }} .sbc-row__card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5), transparent 55%);
    pointer-events: none;
  }

  .sbc-row-{{ section.id }} .sbc-row__label {
    position: absolute;
    left: 14px;
    bottom: 10px;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    font-weight: 600;
  }

  .sbc-row-{{ section.id }} .sbc-row__card:hover .sbc-row__image {
    transform: scale(1.03);
    transition: transform 0.25s ease;
  }

  @media (max-width: 900px) {
    .sbc-row-{{ section.id }} .sbc-row__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 540px) {
    .sbc-row-{{ section.id }} .sbc-row__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<section
  class="sbc-row sbc-row-{{ section.id }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% if section.settings.heading != blank %}
    <div class="sbc-row__header">
      <h2 class="sbc-row__title">{{ section.settings.heading }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="sbc-row__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="sbc-row__grid">
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      {% if collection %}
        {% assign image = collection.image | default: collection.products.first.featured_image %}
        {% assign alt_text = block.settings.custom_title | default: collection.title %}

        <a
          href="{{ collection.url }}"
          class="sbc-row__card"
          {{ block.shopify_attributes }}
        >
          {% if image %}
            <img
              src="{{ image | image_url: width: 900 }}"
              alt="{{ alt_text }}"
              loading="lazy"
              class="sbc-row__image"
            />
          {% endif %}

          <span class="sbc-row__label">
            {{ alt_text }}
          </span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Shop by category row",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title (optional)",
          "info": "Leave empty to use collection title"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Shop by category row (4 cols)",
      "category": "Collection"
    }
  ]
}
{% endschema %}
