<style>
.na-section {
  margin: 0 50px;
}

.na-inner {
    margin: 0 50px;
}

.na-header {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  margin-bottom: 16px;
  position: relative;
}

.na-heading {
  font-size: 18px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  font-weight: 800;
}

.na-view-all {
  position: absolute;
  font-size: 11px;
  top: 25px;
  text-transform: uppercase;
  color: #0000008F;
}

.na-tabs {
  font-weight: 400;
  font-size: 22px;
  display: flex;
  justify-content: center;
  gap: 32px;
  margin-bottom: 20px;
  flex-wrap: wrap;

}

.na-tab {
  border: none;
  background: none;
  font-size: 14px;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  cursor: pointer;
  padding-bottom: 6px;
  position: relative;
  top: 14px;
}

.na-tab.is-active::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  background: #000;
}

.na-panel {
  display: none;
}

.na-panel.is-active {
  display: block;
}

.na-slider-wrap {
  position: relative;
}

.na-slider {
  display: flex;
  overflow-x: auto;
  scroll-behavior: click;
  gap: 23px;
  padding: 4px;
}

.na-slider::-webkit-scrollbar {
  display: none;
}

.na-slide {
  min-width: 220px;
  max-width: 260px;
  flex: 0 0 auto;
}

.na-product-card {
  display: block;
  text-decoration: none;
  color: inherit;
}

.na-product-image-wrap {
  background: #f5f5f5;
}

.na-product-image {
  width: 100%;
  height: auto;
  display: block;
}

.na-product-title {
  margin-top: 8px;
  font-size: 13px;
}

.na-product-price {
  margin-top: 4px;
  font-size: 13px;
}

.na-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  border: none;
  background: rgba(255,255,255,0.9);
  cursor: pointer;
  font-size: 18px;
}

.na-arrow--prev {
    top:-70px;
    left: 499px;
   font-weight: 800;
}

.na-arrow--next {
    top: -70px;
    right: 523px;
    font-weight: 800;
}

@media (max-width: 768px) {
  .na-header {
    justify-content: space-between;
  }

  .na-heading {
    font-size: 16px;
  }

  .na-tabs {
    gap: 16px;
    font-family: Arial;
    font-weight: 400;
    font-size: 22px;
  }

  .na-slide {
    min-width: 60%;
  }

  .na-section {
    margin: 0 16px;
  }
}
</style>

<section
  id="section-{{ section.id }}"
  class="na-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;">

  <div class="na-inner">
    <div class="na-header">
      {% if section.settings.heading != blank %}
        <h3 class="na-heading">{{ section.settings.heading }}</h3>
      {% endif %}

      {% if section.settings.view_all_label != blank %}
        <a
          href="#"
          class="na-view-all"
          data-na-view-all
        >
          {{ section.settings.view_all_label }}
        </a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <!-- Tabs -->
      <div class="na-tabs" role="tablist">
        {% for block in section.blocks %}
          {% assign collection = block.settings.collection %}
          {% if collection %}
            <button
              type="button"
              class="na-tab{% if forloop.first %} is-active{% endif %}"
              role="tab"
              data-na-tab="{{ block.id }}"
            >
              {{ block.settings.tab_label | default: collection.title }}
            </button>
          {% endif %}
        {% endfor %}
      </div>

      <!-- Panels -->
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% if collection %}
          <div
            class="na-panel{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            data-na-panel="{{ block.id }}"
            data-collection-url="{{ collection.url }}"
          >
            <div class="na-slider-wrap">
              <button type="button" class="na-arrow na-arrow--prev" data-na-prev>‹</button>

              <div class="na-slider" data-na-slider>
                {% for product in collection.products limit: block.settings.products_to_show %}
                  <div class="na-slide">
                    <a href="{{ product.url }}" class="na-product-card">
                      {% if product.featured_image %}
                        <div class="na-product-image-wrap">
                          <img
                            src="{{ product.featured_image | image_url: width: 600 }}"
                            alt="{{ product.title | escape }}"
                            class="na-product-image"
                            loading="lazy"
                          >
                        </div>
                      {% endif %}
                      <div class="na-product-title">
                        {{ product.title }}
                      </div>
                      {% if product.price %}
                        <div class="na-product-price">
                          {{ product.price | money }}
                        </div>
                      {% endif %}
                    </a>
                  </div>
                {% endfor %}
              </div>

              <button type="button" class="na-arrow na-arrow--next" data-na-next>›</button>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "New arrivals tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" text",
      "default": "VIEW ALL"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection tab",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab label",
          "info": "Leave empty to use collection title."
        },
        {
          "type": "range",
          "id": "products_to_show",
          "label": "Products to show",
          "min": 2,
          "max": 20,
          "step": 1,
          "default": 8
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "New arrivals tabs",
      "category": "Collection"
    }
  ]
}
{% endschema %}

{% javascript %}
(function() {
  function initNewArrivals(sectionEl) {
    if (!sectionEl) return;

    var tabs = Array.prototype.slice.call(
      sectionEl.querySelectorAll('[data-na-tab]')
    );
    var panels = Array.prototype.slice.call(
      sectionEl.querySelectorAll('[data-na-panel]')
    );
    var viewAll = sectionEl.querySelector('[data-na-view-all]');

    if (!tabs.length || !panels.length) return;

    function setActive(tabId) {
      tabs.forEach(function(tab) {
        tab.classList.toggle('is-active', tab.getAttribute('data-na-tab') === tabId);
      });

      panels.forEach(function(panel) {
        var active = panel.getAttribute('data-na-panel') === tabId;
        panel.classList.toggle('is-active', active);
        if (active && viewAll) {
          var url = panel.getAttribute('data-collection-url');
          if (url) {
            viewAll.setAttribute('href', url);
          }
        }
      });
    }

    // Set initial View all link
    if (panels.length && viewAll) {
      var firstUrl = panels[0].getAttribute('data-collection-url');
      if (firstUrl) {
        viewAll.setAttribute('href', firstUrl);
      }
    }

    // Click handler for tabs (event delegation)
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var id = tab.getAttribute('data-na-tab');
        setActive(id);
      });
    });

    // Slider arrows
    sectionEl.querySelectorAll('.na-slider-wrap').forEach(function(wrap) {
      var slider = wrap.querySelector('[data-na-slider]');
      if (!slider) return;

      var prev = wrap.querySelector('[data-na-prev]');
      var next = wrap.querySelector('[data-na-next]');

      function scrollByAmount(direction) {
        var slide = slider.querySelector('.na-slide');
        var amount = slide ? (slide.offsetWidth + 16) : 250;
        slider.scrollBy({ left: direction * amount, behavior: 'smooth' });
      }

      if (prev) prev.addEventListener('click', function() { scrollByAmount(-1); });
      if (next) next.addEventListener('click', function() { scrollByAmount(1); });
    });
  }

  var sectionEl = document.getElementById('section-{{ section.id }}');
  initNewArrivals(sectionEl);

  // For theme editor when section is reloaded
  document.addEventListener('shopify:section:load', function(event) {
    if (event.detail.sectionId === '{{ section.id }}') {
      initNewArrivals(document.getElementById('section-{{ section.id }}'));
    }
  });
})();
{% endjavascript %}
