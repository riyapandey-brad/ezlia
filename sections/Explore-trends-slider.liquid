<style>
.trends-section {
  margin: 0 50px;
}

.trends-inner {
  margin: 0 auto;
}

.trends-header {
  text-align: center;
  margin-bottom: 24px;
}

.trends-heading {
  font-size: 18px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  font-weight: 800;
}

.trends-subheading {
  font-size: 11px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  margin-top: 4px;
}
.trends-slider-wrap {
  position: relative;
}

.trends-slider {
  display: flex;
  gap: 16px;
  overflow-x: auto;
  scroll-behavior: smooth;
  padding: 4px;
}

.trends-slider::-webkit-scrollbar {
  display: none;
}

.trends-card {
  position: relative;
  flex: 0 0 25%;
  min-width: 260px;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
}

.trends-card__image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.trends-card__overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18px 20px;
  background: linear-gradient(to top, rgba(0,0,0,0.6), transparent 55%);
  color: #fff;
}

.trends-card__title {
  font-size: 20px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  font-weight: 600;
}

.trends-card__subtitle {
  margin-top: 4px;
  font-size: 13px;
}

.trends-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  border: none;
  background: rgba(255,255,255,0.95);
  cursor: pointer;
  font-size: 20px;
  padding: 6px 10px;
  z-index: 2;
}

.trends-arrow--prev { left: 0; }
.trends-arrow--next { right: 0; }

@media (max-width: 900px) {
  .trends-section {
    margin: 0 16px;
  }

  .trends-card {
    flex: 0 0 60%;
    min-width: 60%;
  }
}

@media (max-width: 600px) {
  .trends-card {
    flex: 0 0 80%;
    min-width: 80%;
  }
}
</style>


<section
  id="section-{{ section.id }}"
  class="trends-section"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="trends-inner">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="trends-header">
        {% if section.settings.heading != blank %}
          <h2 class="trends-heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="trends-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="trends-slider-wrap">
        <button type="button" class="trends-arrow trends-arrow--prev" data-trends-prev>‹</button>

        <div class="trends-slider" data-trends-slider>
          {% for block in section.blocks %}
            {% assign col = block.settings.collection %}
            {% assign link_url = col.url | default: block.settings.custom_link %}

            <a
              href="{{ link_url | default: '#' }}"
              class="trends-card"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                {{ block.settings.image
                  | image_url: width: 900
                  | image_tag: class: 'trends-card__image', loading: 'lazy', alt: block.settings.title | escape
                }}
              {% endif %}

              <div class="trends-card__overlay">
                {% if block.settings.title != blank %}
                  <div class="trends-card__title">
                    {{ block.settings.title }}
                  </div>
                {% endif %}
                {% if block.settings.subtitle != blank %}
                  <div class="trends-card__subtitle">
                    {{ block.settings.subtitle }}
                  </div>
                {% endif %}
              </div>
            </a>
          {% endfor %}
        </div>

        <button type="button" class="trends-arrow trends-arrow--next" data-trends-next>›</button>
      </div>
    {% endif %}
  </div>
</section>

<script>
(function() {
  var section = document.getElementById('section-{{ section.id }}');
  if (!section) return;

  var slider = section.querySelector('[data-trends-slider]');
  if (!slider) return;

  var prevBtn = section.querySelector('[data-trends-prev]');
  var nextBtn = section.querySelector('[data-trends-next]');

  function scrollByAmount(direction) {
    var firstSlide = slider.querySelector('.trends-card');
    var amount = firstSlide ? (firstSlide.offsetWidth + 16) : 300;
    slider.scrollBy({ left: direction * amount, behavior: 'smooth' });
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', function() {
      scrollByAmount(-1);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', function() {
      scrollByAmount(1);
    });
  }
})();
</script>


{% schema %}
{
  "name": "Explore trends slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "EXPLORE THE TRENDS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "STEP IT RIGHT"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "trend_card",
      "name": "Trend card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "TRAVEL DIARIES"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": " Subtitle"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Link to collection",
          "info": "Card will link to this collection if set."
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "Custom link (optional)",
          "info": "Used if no collection is selected."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Explore trends slider",
      "category": "Image"
    }
  ]
}
{% endschema %}
