<style>
.about-hero__inner {
  margin: 0 auto;
  text-align: center;
  margin: 0 20px 0 20px;
}

.about-hero__heading {
  font-size: 18px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: 600;
  margin-bottom: 16px;
}

.about-hero__text {
  font-size: 13px;
  line-height: 1.6;
  margin: 0 auto 32px;
}

.about-hero__image-wrap {
  width: 100%;
}

.about-hero__image {
  display: block;
  width: 100%;
  height: auto;
}

@media (min-width: 990px) {
  .about-hero__heading {
    font-size: 20px;
  }
  .about-hero__text {
    font-size: 14px;
    max-width: 900px;
  }
}
</style>
<section
  id="section-{{ section.id }}"
  class="about-hero about-hero-{{ section.id }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="about-hero__inner">
    {% if section.settings.heading != blank %}
      <h2 class="about-hero__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="about-hero__text rte">
        {{ section.settings.text }}
      </div>
    {% endif %}

    {% if section.settings.image != blank %}
      <div class="about-hero__image-wrap">
        {{ section.settings.image
          | image_url: width: 2000
          | image_tag: loading: 'lazy', class: 'about-hero__image'
        }}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ABOUT US"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Since 1866, we have been creating masterfully crafted footwear...</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "About hero",
      "category": "Text"
    }
  ]
}
{% endschema %}
