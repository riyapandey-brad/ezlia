<style>
  .shop-by-category-{{ section.id }} {
    margin: 0 50px 0 50px;
  }

  .shop-by-category-{{ section.id }} .sbc-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .shop-by-category-{{ section.id }} .sbc-title {
    font-size: 20px;
    font-weight: 800;
    text-transform: uppercase;
    margin:20px 0 0 8px;
  }

  .shop-by-category-{{ section.id }} .sbc-subtitle {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    margin: 1px 0 0 30px;
  }

  .shop-by-category-{{ section.id }} .sbc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 220px;
    gap: 12px;
  }

  .shop-by-category-{{ section.id }} .sbc-card {
    position: relative;
    overflow: hidden;
    background: #f5f5f5;
    text-decoration: none;
    display: block;
  }
.shop-by-category-{{ section.id }} .sbc-card:nth-child(3) {
  grid-row: span 2;
  height: 100%;
}


  .shop-by-category-{{ section.id }} .sbc-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shop-by-category-{{ section.id }} .sbc-card__placeholder {
    width: 100%;
    height: 100%;
    background: #e3e3e3;
  }

  .shop-by-category-{{ section.id }} .sbc-card__title {
    position: absolute;
    left: 14px;
    bottom: 10px;
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ffffff;
    font-weight: 600;
  }
  .shop-by-category-{{ section.id }} .sbc-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5), transparent 60%);
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .shop-by-category-{{ section.id }} .sbc-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 180px;
    }
  }

  @media (max-width: 480px) {
    .shop-by-category-{{ section.id }} .sbc-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 240px;
    }
  }
</style>

<section
  class="shop-by-category shop-by-category-{{ section.id }}"
  style="
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {% if section.settings.heading != blank %}
    <div class="sbc-header">
      <h2 class="sbc-title">{{ section.settings.heading }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="sbc-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="sbc-grid">
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}

      {% if collection %}
        {% assign image = collection.image | default: collection.products.first.featured_image %}

        <a
          href="{{ collection.url }}"
          class="sbc-card{% if block.settings.make_large %} sbc-card--large{% endif %}"
          {{ block.shopify_attributes }}
        >
          {% if image %}
            <img
              src="{{ image | image_url: width: 1200 }}"
              alt="{{ block.settings.custom_title | default: collection.title }}"
              class="sbc-card__image"
              loading="lazy"
            >
          {% else %}
            <div class="sbc-card__placeholder"></div>
          {% endif %}

          <span class="sbc-card__title">
            {{ block.settings.custom_title | default: collection.title }}
          </span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Shop by category grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "STEP IT RIGHT"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title (optional)",
          "info": "Leave empty to use collection title"
        },
        {
          "type": "checkbox",
          "id": "make_large",
          "label": "Make this a large card (desktop only)",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Shop by category grid",
      "category": "Collection"
    }
  ]
}
{% endschema %}
