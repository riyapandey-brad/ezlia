<style>
  .mood-bar-wrapper-{{ section.id }} {
    width: 100%;
    height: 34px;

  }

.mood-bar-{{ section.id }} {
    width: 100%;
    height: 34px;
    background-color: #111111;     
    border-top: 1px solid #6ddcff; 
    border-bottom: 1px solid #6ddcff;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;                    
    padding: 10px 20px;
    box-sizing: border-box;
    overflow-x: auto;
    white-space: nowrap;
  }

  .mood-bar-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  .mood-bar__link {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    position: relative;
  }

  @media (max-width: 768px) {
    .mood-bar-{{ section.id }} {
      gap: 20px;
      padding: 8px 16px;
    }

    .mood-bar__link {
      font-size: 11px;
    }
  }
</style>

<div
  class="mood-bar-wrapper mood-bar-wrapper-{{ section.id }}"
  style="margin-top: {{ section.settings.margin_top }}px; margin-bottom: {{ section.settings.margin_bottom }}px;"
>
  <nav class="mood-bar mood-bar-{{ section.id }}">
    {% for block in section.blocks %}
      {% if block.settings.label != blank %}
        <a
          href="{{ block.settings.url | default: '#' }}"
          class="mood-bar__link"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label }}
        </a>
      {% endif %}
    {% endfor %}
  </nav>
</div>
{% schema %}
{
  "name": "Category / Mood bar",
  "settings": [
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Heading link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Heading text",
          "default": "PICK A MOOD"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Category bar",
      "category": "Custom"
    }
  ]
}
{% endschema %}
